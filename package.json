{
  "name": "@mudraforge/statutory",
  "version": "2.10.0",
  "description": "Open Knowledge Format (OKF) client & AI Agent Skill for Indian and cross-border statutory tax provisions. Zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./outcomes": {
      "types": "./types/index.d.ts",
      "import": "./src/outcomes.js",
      "default": "./src/outcomes.js"
    },
    "./constants": {
      "types": "./types/index.d.ts",
      "import": "./src/constants.js",
      "default": "./src/constants.js"
    },
    "./calculators": {
      "types": "./types/index.d.ts",
      "import": "./src/calculators.js",
      "default": "./src/calculators.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "calculators": [
        "./types/index.d.ts"
      ],
      "outcomes": [
        "./types/index.d.ts"
      ],
      "constants": [
        "./types/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "bin": {
    "statutory": "bin/cli.js",
    "mudraforge-statutory": "bin/cli.js"
  },
  "files": [
    "src",
    "types",
    "bin",
    "okf",
    "calculators.js",
    "calculators.d.ts",
    "docs",
    "SKILL.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "okf.publication.json",
    "conformance",
    "examples",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node scripts/prepublish_gate.js",
    "test": "node test.js",
    "validate": "node scripts/validate_okf.js",
    "citations": "node scripts/verify_citation_links.js",
    "conformance": "node conformance/test_conformance.js",
    "quality": "node scripts/corpus_quality_report.js",
    "example:trace": "node examples/simulate_end_to_end_trace.js",
    "manifest": "node scripts/generate_manifest.js",
    "manifest:check": "node scripts/generate_manifest.js --check",
    "catalog": "node scripts/build_catalog.js",
    "release": "node scripts/release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mondeep0123/mudraforge-statutory.git"
  },
  "homepage": "https://mudraforge.in/docs",
  "bugs": {
    "url": "https://github.com/mondeep0123/mudraforge-statutory/issues"
  },
  "keywords": [
    "tax",
    "india",
    "tds",
    "income-tax",
    "income-tax-act-2025",
    "msme",
    "section-43bh",
    "gst",
    "section-194q",
    "section-206c",
    "ai-agent",
    "skill",
    "mcp",
    "okf"
  ],
  "author": "MudraForge Technologies <engineering@mudraforge.in>",
  "license": "MIT AND CC-BY-4.0"
}

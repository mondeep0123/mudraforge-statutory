{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GSTR-3B Table 4(B)(2) Reclaimable ITC Reversal Schedule",
  "description": "Statutory reporting schema for Rule 37 (180 days non-payment) and Rule 37A ITC reversals and subsequent Table 4(D)(1) re-availment",
  "type": "object",
  "required": [
    "recipientGstin",
    "returnPeriod",
    "invoiceNumber",
    "invoiceDate",
    "supplierGstin",
    "totalInvoiceAmountInr",
    "totalItcAvailmentInr",
    "unpaidAmountInr",
    "reversalType",
    "itcReversalAmountInr",
    "interestApplicableInr",
    "isReclaimable"
  ],
  "properties": {
    "recipientGstin": {
      "type": "string",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "returnPeriod": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])20[2-9][0-9]$"
    },
    "invoiceNumber": {
      "type": "string"
    },
    "invoiceDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "supplierGstin": {
      "type": "string",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "totalInvoiceAmountInr": {
      "type": "number",
      "minimum": 0
    },
    "totalItcAvailmentInr": {
      "type": "number",
      "minimum": 0
    },
    "unpaidAmountInr": {
      "type": "number",
      "minimum": 0
    },
    "daysOverdueBeyond180": {
      "type": "integer",
      "minimum": 0
    },
    "reversalType": {
      "type": "string",
      "enum": ["RULE_37_180_DAYS_VENDOR_NON_PAYMENT", "RULE_37A_SUPPLIER_GSTR3B_NON_FILING"]
    },
    "gstr3bReportingTable": {
      "type": "string",
      "enum": ["TABLE_4_B_2_OTHERS_RECLAIMABLE"]
    },
    "itcReversalAmountInr": {
      "type": "number",
      "minimum": 0
    },
    "interestApplicableInr": {
      "type": "number",
      "minimum": 0
    },
    "isReclaimable": {
      "type": "boolean",
      "const": true
    },
    "reAvailmentStatus": {
      "type": "string",
      "enum": ["PENDING_PAYMENT", "PAID_RECLAIMED", "NOT_APPLICABLE"]
    }
  }
}

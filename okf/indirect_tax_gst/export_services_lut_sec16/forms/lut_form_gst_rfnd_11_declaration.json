{
  "formCode": "FORM_GST_RFD_11",
  "title": "Furnishing of Letter of Undertaking (LUT) for Export of Goods or Services",
  "statutoryBasis": "Section 16 of IGST Act, 2017 read with Rule 96A of CGST Rules, 2017",
  "schema": {
    "exporterParticulars": {
      "type": "object",
      "required": true,
      "properties": {
        "legalName": { "type": "string", "required": true },
        "tradeName": { "type": "string", "required": false },
        "gstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "required": true },
        "pan": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "required": true },
        "financialYear": { "type": "string", "pattern": "^20[0-9]{2}-20[0-9]{2}$", "required": true },
        "lutArn": { "type": "string", "required": true }
      }
    },
    "exportDeclarationDetails": {
      "type": "object",
      "required": true,
      "properties": {
        "exportType": { "type": "string", "enum": ["SERVICES", "GOODS", "SEZ_SUPPLIES"], "required": true },
        "zeroRatedUnderLut": { "type": "boolean", "required": true },
        "recipientLocation": { "type": "string", "required": true },
        "currencyOfInvoice": { "type": "string", "pattern": "^[A-Z]{3}$", "required": true },
        "isIntermediaryService": { "type": "boolean", "required": true },
        "statutoryEndorsementText": {
          "type": "string",
          "enum": [
            "SUPPLY MEANT FOR EXPORT/SUPPLY TO SEZ UNIT OR SEZ DEVELOPER FOR AUTHORISED OPERATIONS UNDER BOND OR LETTER OF UNDERTAKING WITHOUT PAYMENT OF INTEGRATED TAX"
          ],
          "required": true
        }
      }
    },
    "forexRealizationUndertaking": {
      "type": "object",
      "required": true,
      "properties": {
        "maxRealizationPeriodMonths": { "type": "number", "default": 12, "required": true },
        "fircOrEbrcRequired": { "type": "boolean", "default": true, "required": true },
        "interestPayableUnderSection50": { "type": "number", "default": 18.0, "required": true }
      }
    },
    "witnessSignatures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true },
          "occupation": { "type": "string", "required": true },
          "address": { "type": "string", "required": true }
        }
      }
    }
  }
}
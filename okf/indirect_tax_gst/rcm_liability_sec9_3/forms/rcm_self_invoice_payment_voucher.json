{
  "formCode": "RCM_SELF_INVOICE_PAYMENT_VOUCHER",
  "title": "CGST Section 31(3)(f) Self-Invoice and Section 31(3)(g) Payment Voucher Schema",
  "statutoryBasis": "Section 9(3) read with Section 31(3)(f) and 31(3)(g) of CGST Act, 2017",
  "schema": {
    "recipientDetails": {
      "type": "object",
      "required": true,
      "properties": {
        "legalName": { "type": "string", "required": true },
        "gstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "required": true },
        "stateCode": { "type": "string", "pattern": "^[0-9]{2}$", "required": true }
      }
    },
    "supplierDetails": {
      "type": "object",
      "required": true,
      "properties": {
        "supplierName": { "type": "string", "required": true },
        "isUnregistered": { "type": "boolean", "required": true },
        "pan": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "required": false }
      }
    },
    "selfInvoiceParticulars": {
      "type": "object",
      "required": true,
      "properties": {
        "selfInvoiceNumber": { "type": "string", "required": true },
        "selfInvoiceDate": { "type": "string", "format": "date", "required": true },
        "serviceCategory": {
          "type": "string",
          "enum": ["GTA_SERVICES", "LEGAL_SERVICES", "DIRECTOR_SERVICES", "SPONSORSHIP", "SECURITY_PERSONNEL", "OTHER_SPECIFIED_RCM"],
          "required": true
        },
        "taxableValueInr": { "type": "number", "required": true },
        "cgstRatePercent": { "type": "number", "required": true },
        "cgstAmountInr": { "type": "number", "required": true },
        "sgstRatePercent": { "type": "number", "required": true },
        "sgstAmountInr": { "type": "number", "required": true },
        "igstRatePercent": { "type": "number", "required": true },
        "igstAmountInr": { "type": "number", "required": true },
        "totalRcmTaxPayableInr": { "type": "number", "required": true }
      }
    },
    "paymentVoucherParticulars": {
      "type": "object",
      "required": true,
      "properties": {
        "voucherNumber": { "type": "string", "required": true },
        "voucherDate": { "type": "string", "format": "date", "required": true },
        "disbursedAmountInr": { "type": "number", "required": true },
        "paymentMode": { "type": "string", "enum": ["NEFT", "RTGS", "CHEQUE", "UPI"], "required": true }
      }
    },
    "cashLedgerDischargeVerification": {
      "type": "object",
      "required": true,
      "properties": {
        "gstr3bTaxPeriod": { "type": "string", "pattern": "^(0[1-9]|1[0-2])20[0-9]{2}$", "required": true },
        "electronicCashLedgerDebitReference": { "type": "string", "required": true },
        "isDischargedInCashStrictly": { "type": "boolean", "required": true }
      }
    }
  }
}

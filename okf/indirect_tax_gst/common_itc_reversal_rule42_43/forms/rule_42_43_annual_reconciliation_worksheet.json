{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule 42(2) & 43 Annual ITC Reversal & True-up Worksheet",
  "description": "Statutory audit and annual reconciliation schedule under Rule 42(2) comparing aggregate financial year reversals with monthly GSTR-3B Table 4(B)(1) filings, with Section 50(1) 18% statutory interest on shortfalls",
  "type": "object",
  "required": [
    "recipientGstin",
    "financialYear",
    "annualGrossItcTInr",
    "annualCommonCreditC2Inr",
    "annualExemptTurnoverEInr",
    "annualTotalTurnoverFInr",
    "annualRequiredReversalRule42Inr",
    "cumulativeMonthlyReversalsMadeInr",
    "reconciliationOutcome",
    "netAdjustmentAmountInr",
    "trueUpExecutionDate",
    "statutoryCutoffDate",
    "section50InterestRatePercent",
    "section50InterestApplicableInr"
  ],
  "properties": {
    "recipientGstin": {
      "type": "string",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "financialYear": {
      "type": "string",
      "pattern": "^20[2-9][0-9]-[0-9]{2}$"
    },
    "annualGrossItcTInr": {
      "type": "number",
      "minimum": 0
    },
    "annualCommonCreditC2Inr": {
      "type": "number",
      "minimum": 0
    },
    "annualExemptTurnoverEInr": {
      "type": "number",
      "minimum": 0
    },
    "annualTotalTurnoverFInr": {
      "type": "number",
      "minimum": 0
    },
    "annualRequiredReversalRule42Inr": {
      "type": "number",
      "minimum": 0
    },
    "cumulativeMonthlyReversalsMadeInr": {
      "type": "number",
      "minimum": 0
    },
    "reconciliationOutcome": {
      "type": "string",
      "enum": ["SHORT_REVERSAL_PAYMENT_DUE", "EXCESS_REVERSAL_RECLAIM_PERMITTED", "BALANCED_ZERO_VARIANCE"]
    },
    "netAdjustmentAmountInr": {
      "type": "number",
      "minimum": 0
    },
    "trueUpExecutionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "statutoryCutoffDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "isFiledBeforeCutoff": {
      "type": "boolean"
    },
    "interestPeriodDays": {
      "type": "integer",
      "minimum": 0
    },
    "section50InterestRatePercent": {
      "type": "number",
      "const": 18
    },
    "section50InterestApplicableInr": {
      "type": "number",
      "minimum": 0
    }
  }
}

{
  "formCode": "SECTION_79_SHAREHOLDING_CONTINUITY_SCHEDULE",
  "title": "Corporate Shareholding Continuity & Loss Set-Off Schedule under Section 79",
  "statutoryBasis": "Section 79 read with Section 32(2) and Section 72 of Income-tax Act, 1961",
  "schema": {
    "corporateEntity": {
      "type": "object",
      "required": true,
      "properties": {
        "companyName": { "type": "string", "required": true },
        "pan": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "required": true },
        "isCloselyHeldCompany": { "type": "boolean", "required": true },
        "isDpiitRecognizedStartup": { "type": "boolean", "default": false, "required": true },
        "isUnderIbcResolution": { "type": "boolean", "default": false, "required": true }
      }
    },
    "shareholdingComparison": {
      "type": "object",
      "required": true,
      "properties": {
        "lossYearEnd": { "type": "string", "pattern": "^20[0-9]{2}-03-31$", "required": true },
        "currentYearEnd": { "type": "string", "pattern": "^20[0-9]{2}-03-31$", "required": true },
        "originalShareholdersVotingPowerPercent": { "type": "number", "minimum": 0, "maximum": 100, "required": true },
        "continuingShareholdersVotingPowerPercent": { "type": "number", "minimum": 0, "maximum": 100, "required": true },
        "isFiftyOnePercentContinuitySatisfied": { "type": "boolean", "required": true },
        "isAllShareholdersRetainedStartupTest": { "type": "boolean", "required": false }
      }
    },
    "lossSetOffApportionment": {
      "type": "object",
      "required": true,
      "properties": {
        "accumulatedBusinessLossBroughtForwardInr": { "type": "number", "required": true },
        "accumulatedUnabsorbedDepreciationInr": { "type": "number", "required": true },
        "allowedBusinessLossSetOffInr": { "type": "number", "required": true },
        "forfeitedBusinessLossInr": { "type": "number", "required": true },
        "allowedUnabsorbedDepreciationSetOffInr": { "type": "number", "required": true },
        "statutoryLegalBasis": {
          "type": "string",
          "enum": [
            "SECTION_79_CONTINUITY_MAINTAINED",
            "SECTION_79_FORFEITURE_UNABSORBED_DEP_PROTECTED_VIRMANI",
            "SECTION_79_2_STARTUP_CARVEOUT",
            "SECTION_79_2_C_IBC_CARVEOUT"
          ],
          "required": true
        }
      }
    }
  }
}
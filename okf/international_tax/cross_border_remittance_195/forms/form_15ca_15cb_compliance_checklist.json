{
  "formCode": "FORM_15CA_15CB_CHECKLIST",
  "title": "Rule 37BB Form 15CA and Form 15CB Foreign Remittance Compliance Checklist",
  "statutoryBasis": "Section 195(6) of Income-tax Act, 1961 read with Rule 37BB",
  "schema": {
    "remittanceReference": {
      "type": "string",
      "required": true
    },
    "remitterDetails": {
      "type": "object",
      "required": true,
      "properties": {
        "pan": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "required": true },
        "name": { "type": "string", "required": true },
        "status": { "type": "string", "enum": ["COMPANY", "LLP", "FIRM", "INDIVIDUAL"], "required": true }
      }
    },
    "beneficiaryDetails": {
      "type": "object",
      "required": true,
      "properties": {
        "legalName": { "type": "string", "required": true },
        "countryOfResidence": { "type": "string", "required": true },
        "taxIdentificationNumber": { "type": "string", "required": true }
      }
    },
    "remittanceFinancials": {
      "type": "object",
      "required": true,
      "properties": {
        "currency": { "type": "string", "required": true },
        "amountForeignCurrency": { "type": "number", "required": true },
        "exchangeRate": { "type": "number", "required": true },
        "amountInr": { "type": "number", "required": true },
        "natureOfRemittance": {
          "type": "string",
          "enum": ["CLOUD_SAAS_INFRASTRUCTURE", "SOFTWARE_LICENSE", "TECHNICAL_SERVICES", "CONSULTING_LEGAL", "DIVIDENDS", "ROYALTY", "OTHER"],
          "required": true
        }
      }
    },
    "treatyEntitlementCheck": {
      "type": "object",
      "required": true,
      "properties": {
        "hasValidTrc": { "type": "boolean", "required": true },
        "hasElectronicForm10F": { "type": "boolean", "required": true },
        "hasNoPeDeclaration": { "type": "boolean", "required": true },
        "applicableDtaaArticle": { "type": "string", "required": true }
      }
    },
    "statutoryForm15caPart": {
      "type": "string",
      "enum": [
        "PART_A_TAXABLE_LESS_THAN_5LAKH",
        "PART_B_CERTIFICATE_UNDER_195_2_195_3_197",
        "PART_C_TAXABLE_EXCEEDING_5LAKH_WITH_15CB",
        "PART_D_NON_TAXABLE_REMITTANCE"
      ],
      "required": true
    },
    "withholdingDetermination": {
      "type": "object",
      "required": true,
      "properties": {
        "applicableTdsRatePercent": { "type": "number", "required": true },
        "taxDeductedInr": { "type": "number", "required": true },
        "requiresForm15cb": { "type": "boolean", "required": true }
      }
    }
  }
}

{
  "formCode": "FORM_MSME_1",
  "title": "Form MSME-1: Half-Yearly Return with Registrar of Companies in respect of outstanding dues to Micro or Small Enterprise Suppliers",
  "statutoryBasis": "Section 405 of Companies Act, 2013 read with Specified Companies Order, 2019",
  "authority": "Ministry of Corporate Affairs (MCA)",
  "reportingPeriodFrequency": "HALF_YEARLY",
  "filingDeadlines": {
    "halfYear1": {
      "period": "April 1 to September 30",
      "dueDate": "October 31"
    },
    "halfYear2": {
      "period": "October 1 to March 31",
      "dueDate": "April 30"
    }
  },
  "fields": {
    "corporateIdentificationNumber": {
      "type": "string",
      "pattern": "^[UL][0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$",
      "required": true,
      "description": "21-character CIN of reporting company"
    },
    "reportingHalfYear": {
      "type": "string",
      "enum": ["OCTOBER_TO_MARCH", "APRIL_TO_SEPTEMBER"],
      "required": true
    },
    "financialYear": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}$",
      "required": true
    },
    "totalOutstandingOverdueInr": {
      "type": "number",
      "required": true,
      "description": "Aggregate amount of principal remaining unpaid exceeding 45 days"
    },
    "overdueSupplierEntries": {
      "type": "array",
      "required": true,
      "items": {
        "supplierPan": {
          "type": "string",
          "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
          "required": true
        },
        "supplierName": {
          "type": "string",
          "required": true
        },
        "udyamRegistrationNumber": {
          "type": "string",
          "pattern": "^UDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}$",
          "required": true
        },
        "invoiceNumber": {
          "type": "string",
          "required": true
        },
        "invoiceDate": {
          "type": "string",
          "format": "date",
          "required": true
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "required": true
        },
        "outstandingAmountInr": {
          "type": "number",
          "required": true
        },
        "delayReasonCode": {
          "type": "string",
          "enum": [
            "COMMERCIAL_DISPUTE_SUB_JUDICE",
            "DEFECTIVE_GOODS_SERVICES_NOTICED",
            "DOCUMENTATION_RECONCILIATION_PENDING",
            "BUYER_LIQUIDITY_DELAY",
            "OTHER"
          ],
          "required": true
        },
        "reasonDescription": {
          "type": "string",
          "required": true
        }
      }
    }
  }
}

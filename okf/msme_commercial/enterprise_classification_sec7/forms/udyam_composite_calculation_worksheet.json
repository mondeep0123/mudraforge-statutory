{
  "formCode": "UDYAM_COMPOSITE_CALCULATION",
  "title": "MSME Composite Criteria Classification & Export Turnover Carve-Out Worksheet",
  "statutoryBasis": "Section 7 of MSMED Act, 2006 read with Notification S.O. 2119(E)",
  "schema": {
    "enterpriseName": {
      "type": "string",
      "required": true
    },
    "pan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
      "required": true
    },
    "financialYear": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}$",
      "required": true
    },
    "investmentComputation": {
      "type": "object",
      "required": true,
      "properties": {
        "grossPlantAndMachineryWdvInr": { "type": "number", "required": true },
        "lessPollutionControlEquipmentInr": { "type": "number", "required": true },
        "lessRandDEquipmentInr": { "type": "number", "required": true },
        "netQualifyingInvestmentInr": { "type": "number", "required": true }
      }
    },
    "turnoverComputation": {
      "type": "object",
      "required": true,
      "properties": {
        "grossTotalTurnoverInr": { "type": "number", "required": true },
        "lessExportOfGoodsTurnoverInr": { "type": "number", "required": true },
        "lessExportOfServicesTurnoverInr": { "type": "number", "required": true },
        "netQualifyingTurnoverInr": { "type": "number", "required": true }
      }
    },
    "statutoryClassificationResult": {
      "type": "string",
      "enum": ["MICRO", "SMALL", "MEDIUM", "EXCEEDS_MSME_LIMITS"],
      "required": true
    }
  }
}

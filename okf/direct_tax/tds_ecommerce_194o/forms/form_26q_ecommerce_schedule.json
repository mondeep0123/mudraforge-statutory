{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Form 26Q Section 194O E-Commerce Operator TDS Schedule",
  "description": "Statutory reporting schedule for e-commerce operators deducting tax on marketplace participants under Section 194O",
  "type": "object",
  "required": [
    "operatorTan",
    "financialYear",
    "quarter",
    "participantPan",
    "participantEntityType",
    "grossAmountOfSalesOrServices",
    "dateOfCreditOrPayment",
    "rateOfTdsPercent",
    "tdsDeductedInr",
    "challanDetails"
  ],
  "properties": {
    "operatorTan": {
      "type": "string",
      "pattern": "^[A-Z]{4}[0-9]{5}[A-Z]{1}$"
    },
    "financialYear": {
      "type": "string",
      "pattern": "^20[2-9][0-9]-20[2-9][0-9]$"
    },
    "quarter": {
      "type": "string",
      "enum": ["Q1", "Q2", "Q3", "Q4"]
    },
    "participantPan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
    },
    "participantEntityType": {
      "type": "string",
      "enum": ["INDIVIDUAL_HUF", "COMPANY", "PARTNERSHIP_FIRM", "LLP", "OTHER"]
    },
    "grossAmountOfSalesOrServices": {
      "type": "number",
      "minimum": 0
    },
    "directPurchaserPaymentDeemed": {
      "type": "number",
      "minimum": 0,
      "description": "Portion paid directly by buyer to seller deemed paid by operator u/s 194O(1) explanation"
    },
    "dateOfCreditOrPayment": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rateOfTdsPercent": {
      "type": "number",
      "enum": [0.0, 0.1, 1.0, 5.0]
    },
    "tdsDeductedInr": {
      "type": "number",
      "minimum": 0
    },
    "reasonForLowerOrNonDeduction": {
      "type": "string",
      "enum": ["A", "Y", "NONE"],
      "description": "A: Section 197 certificate, Y: Individual/HUF below ₹5 Lakh threshold, NONE: Standard"
    },
    "challanDetails": {
      "type": "object",
      "required": ["bsrCode", "dateOfChallan", "challanSerialNumber"],
      "properties": {
        "bsrCode": { "type": "string", "pattern": "^[0-9]{7}$" },
        "dateOfChallan": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "challanSerialNumber": { "type": "string" }
      }
    }
  }
}

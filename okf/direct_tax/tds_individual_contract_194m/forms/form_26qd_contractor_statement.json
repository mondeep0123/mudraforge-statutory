{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Form 26QD Section 194M Contractor/Professional Challan-Cum-Statement",
  "description": "Statutory return and challan-cum-statement for payment of tax deducted on contractual, brokerage, or professional fees under Section 194M",
  "type": "object",
  "required": [
    "financialYear",
    "deductorPan",
    "payeePan",
    "paymentCategory",
    "cumulativePaymentAmountInr",
    "currentPaymentAmountInr",
    "dateOfCreditOrPayment",
    "rateOfTdsPercent",
    "tdsDeductedInr"
  ],
  "properties": {
    "financialYear": {
      "type": "string",
      "pattern": "^20[2-9][0-9]-20[2-9][0-9]$"
    },
    "deductorPan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
    },
    "payeePan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
    },
    "paymentCategory": {
      "type": "string",
      "enum": ["CONTRACT_WORK_194C_NATURE", "COMMISSION_BROKERAGE_194H_NATURE", "PROFESSIONAL_FEES_194J_NATURE"]
    },
    "cumulativePaymentAmountInr": {
      "type": "number",
      "minimum": 0
    },
    "currentPaymentAmountInr": {
      "type": "number",
      "minimum": 0
    },
    "dateOfCreditOrPayment": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rateOfTdsPercent": {
      "type": "number",
      "enum": [0.0, 2.0, 5.0, 20.0]
    },
    "tdsDeductedInr": {
      "type": "number",
      "minimum": 0
    },
    "challanDetails": {
      "type": "object",
      "properties": {
        "bsrCode": { "type": "string", "pattern": "^[0-9]{7}$" },
        "dateOfChallan": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "challanSerialNumber": { "type": "string" },
        "cin": { "type": "string" }
      }
    }
  }
}
